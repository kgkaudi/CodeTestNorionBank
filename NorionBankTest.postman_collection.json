	"info": {
		"_postman_id": "69224abf-4eda-4edc-a8d4-28fe0a5ed38b",
		"name": "NorionBankTest",
		"description": "Gothenburg congestion tax API — POST /api/tollfee/calculate.\n\nAll requests use the {{baseUrl}} collection variable so the port only needs updating in one place if `dotnet run` picks a different one.\n\nDates used throughout are the same 2013 dates covered by the automated unit tests (TollCalculatorTests), so the expected fees here match what's asserted in code.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "45236529"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5238",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Happy path",
			"item": [
				{
					"name": "Regular weekday passages (26 SEK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const body = pm.response.json();",
									"pm.test(\"Total fee is 26 SEK (8 + 18, more than 60 min apart)\", function () {",
									"    pm.expect(body.totalFee).to.eql(26);",
									"});",
									"pm.test(\"Currency is SEK\", function () {",
									"    pm.expect(body.currency).to.eql(\"SEK\");",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"vehicleType\": \"car\",\n    \"passages\": [\n        \"2013-01-02T06:00:00\",\n        \"2013-01-02T07:30:00\"\n    ]\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/tollfee/calculate",
